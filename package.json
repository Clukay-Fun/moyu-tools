{
  "name": "moyu-tools",
  "version": "2.1.0",
  "description": "摸鱼工具箱桌面应用（基于 DeepSeek Harness）",
  "author": "Clukay",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:icon": "node scripts/generate-icon.mjs",
    "build:tools:win": "powershell -ExecutionPolicy Bypass -File scripts/download-ffmpeg-win.ps1",
    "build:win": "npm run build:icon && npm run build:tools:win && npm run build && electron-builder --win nsis --x64",
    "build:win:nsis": "npm run build:icon && npm run build:tools:win && npm run build && electron-builder --win nsis --x64",
    "build:win:portable": "npm run build:icon && npm run build:tools:win && npm run build && electron-builder --win portable --x64",
    "build:win:dir": "npm run build:icon && npm run build:tools:win && npm run build && electron-builder --win dir --x64 && node scripts/zip-win-unpacked.mjs",
    "preview": "electron-vite preview"
  },
  "build": {
    "appId": "com.clukay.moyutools",
    "productName": "摸鱼工具箱",
    "asar": true,
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/winax/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "licenses/**/*",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "licenses",
        "to": "licenses",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "resources/com-worker.cjs",
        "to": "workers/com-worker.cjs"
      }
    ],
    "win": {
      "extraResources": [
        {
          "from": "build/ffmpeg",
          "to": "tools/ffmpeg"
        },
        {
          "from": "build/icon.ico",
          "to": "icon.ico"
        },
        {
          "from": "assets/app-icon.png",
          "to": "app-icon.png"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "artifactName": "moyu-tools-v${version}-windows-x64-setup.${ext}"
    },
    "portable": {
      "artifactName": "moyu-tools-v${version}-windows-x64-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-static": "^1.30.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "fabric": "5.5.2-browser",
    "gs1encoder": "1.4.1",
    "jsbarcode": "3.12.3",
    "opentype.js": "2.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624",
    "qpdf-run": "0.2.1",
    "sharp": "0.35.3",
    "tesseract.js": "7.0.0"
  },
  "optionalDependencies": {
    "winax": "3.6.9"
  }
}
